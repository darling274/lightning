{
  "name": "@lightning/baileys",
  "version": "4.1.0",
  "description": "Standalone WhatsApp toolkit with a vendored Baileys engine (no @whiskeysockets/baileys dependency): extended messages, MongoDB sessions, crash-safe auth and auto-reconnect.",
  "type": "module",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "lightning": "bin/miniwa.js"
  },
  "files": [
    "src",
    "bin",
    "LICENSE",
    "NOTICE.md",
    "CHANGELOG.md",
    "README.md"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "example:bot": "node examples/bot.js",
    "example:baileys": "node examples/baileys-style.js",
    "example:mongo": "node examples/mongo.js",
    "example:upserts": "node examples/upserts.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "keywords": [
    "whatsapp",
    "baileys",
    "whiskeysockets",
    "bot",
    "mongodb",
    "multi-device",
    "session",
    "auth-state",
    "interactive-messages",
    "termux"
  ],
  "dependencies": {
    "@cacheable/node-cache": "^1.4.0",
    "@hapi/boom": "^9.1.3",
    "async-mutex": "^0.5.0",
    "fflate": "^0.8.2",
    "libsignal": "^6.0.0",
    "long": "^5.2.3",
    "lru-cache": "^11.1.0",
    "music-metadata": "^11.12.3",
    "p-queue": "^9.0.0",
    "pino": "^9.6",
    "protobufjs": "^7.5.6",
    "whatsapp-rust-bridge": "0.5.4",
    "ws": "^8.13.0"
  },
  "peerDependencies": {
    "mongodb": ">=6"
  },
  "peerDependenciesMeta": {
    "mongodb": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "sharp": "^0.33.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "mongodb": "^7.7.0",
    "typescript": "^7.0.2"
  }
}
